rules_version = '2';

// Audit-trail copy of the Firestore rules published in the Firebase console for
// project financialplan-60c6e (same convention as team-dashboard and
// sprint-velocity). The console is what actually enforces; if the console
// changes, change this file in the same breath. The match lines below are
// verbatim from the console (2026-08-11); the comments describe THIS app.

service cloud.firestore {
  match /databases/{database}/documents {

    // Sync stores one document per signed-in user, holding { json, updatedAt } —
    // the whole state as ONE JSON string, never Firestore fields, because
    // Firestore rejects arrays nested inside arrays and the plan's free-form
    // tables are exactly that (see the sync module in index.html).
    // The {uid} path segment is the user's Firebase auth UID, so comparing it to
    // request.auth.uid is what confines each account to its own record — a rule of
    // just `request.auth != null` would let any signed-in Google account read every
    // other user's plan, while refusing anonymous callers identically, so the
    // difference is invisible from outside.
    match /financialplan/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default: there is deliberately no
    // `match /{document=**}` catch-all, and the app touches no other path.
  }
}
